# ─── Session ──────────────────────────────────────────────────────────────────
# 32+ random chars. Signs the session cookie (local auth adapter).
SESSION_SECRET=

# ─── Database ─────────────────────────────────────────────────────────────────
# Empty = embedded Postgres (PGlite). Production uses Supabase.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Billing (phase 06) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Mail + LLM (phases 04 and 07) ────────────────────────────────────────────
RESEND_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Dev only ─────────────────────────────────────────────────────────────────
# Set to 1 to enable /api/dev/seed. Refused when NODE_ENV=production.
RROS_DEV_SEED=
