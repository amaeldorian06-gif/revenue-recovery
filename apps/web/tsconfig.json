    "baseUrl": ".",
    "composite": false,
    "incremental": false,
    "allowJs": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/db/src/**/*.ts",
    "../../packages/i18n/src/**/*.ts",
    "../../packages/domain/src/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts"
  ]
}
