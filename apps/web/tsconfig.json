      ],
      "@rros/domain/sending/send": [
        "../../packages/domain/src/sending/send.ts"
      ],
      "@rros/domain/sending/providers/index": [
        "../../packages/domain/src/sending/providers/index.ts"
      ],
      "@rros/domain/sending/providers/memory": [
        "../../packages/domain/src/sending/providers/memory.ts"
      ],
      "@rros/db/measurement": [
        "../../packages/db/src/repo/measurement.ts"
      ],
      "@rros/domain/measurement/attribution": [
        "../../packages/domain/src/measurement/attribution.ts"
      ],
      "@rros/domain/measurement/headline": [
        "../../packages/domain/src/measurement/headline.ts"
      ],
      "@rros/domain/measurement/weeklyEmail": [
        "../../packages/domain/src/measurement/weeklyEmail.ts"
      ],
      "@rros/db/billing": [
        "../../packages/db/src/repo/billing.ts"
      ],
      "@rros/db/onboarding": [
        "../../packages/db/src/repo/onboarding.ts"
      ],
      "@rros/domain/billing/access": [
        "../../packages/domain/src/billing/access.ts"
      ],
      "@rros/domain/billing/stateMachine": [
        "../../packages/domain/src/billing/stateMachine.ts"
      ],
      "@rros/domain/billing/signature": [
        "../../packages/domain/src/billing/signature.ts"
      ],
      "@rros/db/inbox": [
        "../../packages/db/src/repo/inbox.ts"
      ],
      "@rros/domain/inbox/provider": [
        "../../packages/domain/src/inbox/provider.ts"
      ],
      "@rros/domain/inbox/normalize": [
        "../../packages/domain/src/inbox/normalize.ts"
      ],
      "@rros/domain/inbox/match": [
        "../../packages/domain/src/inbox/match.ts"
