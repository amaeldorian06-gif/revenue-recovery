        "../../packages/i18n/src/index.ts"
      ],
      "@rros/domain/authz": [
        "../../packages/domain/src/authz/can.ts"
      ],
      "@rros/db/repo": [
        "../../packages/db/src/repo/workspaces.ts"
      ],
      "@rros/db/imports": [
        "../../packages/db/src/repo/imports.ts"
      ],
      "@rros/domain/import/parse": [
        "../../packages/domain/src/import/parse.ts"
      ],
      "@rros/domain/import/detect": [
        "../../packages/domain/src/import/detect.ts"
      ],
      "@rros/domain/import/pipeline": [
        "../../packages/domain/src/import/pipeline.ts"
      ],
      "@rros/domain/entitlements": [
        "../../packages/domain/src/entitlements/check.ts"
      ],
      "@rros/domain/classify": [
        "../../packages/domain/src/classify/state.ts"
