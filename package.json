{
  "name": "revenue-recovery-os",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build": "npm run build --workspace @rros/web",
    "dev": "npm run dev --workspace @rros/web",
    "db:migrate": "node --experimental-strip-types packages/db/src/migrate.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.13",
    "@embedded-postgres/linux-x64": "^18.4.0-beta.17",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "iconv-lite": "^0.7.3",
    "jose": "^5.10.0",
    "next": "^15.5.28",
    "nodemailer": "^10.2.1",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  }
}
